{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Silicio",
  "version": "0.1.0",
  "identifier": "br.com.silicio.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && cargo build --release --bin silicio-helper --manifest-path src-tauri/Cargo.toml",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Silício",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Informações de hardware com visual moderno",
    "category": "Utility",
    "publisher": "Diógenes A. Anghievischi",
    "homepage": "https://github.com/Anghievischi/silicio",
    "longDescription": "Alternativa moderna ao CPU-Z: processador, placa-mãe, memória, SPD e placa de vídeo com dados ao vivo.",
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/silicio/silicio-helper": "target/release/silicio-helper",
          "/usr/share/polkit-1/actions/br.com.silicio.helper.policy": "../packaging/linux/br.com.silicio.helper.policy"
        },
        "depends": [
          "polkitd | policykit-1"
        ]
      },
      "rpm": {
        "files": {
          "/usr/lib/silicio/silicio-helper": "target/release/silicio-helper",
          "/usr/share/polkit-1/actions/br.com.silicio.helper.policy": "../packaging/linux/br.com.silicio.helper.policy"
        },
        "depends": [
          "polkit"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ]
      }
    }
  }
}
